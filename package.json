{
  "name": "wonju-triage-rag",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:kb": "node --env-file=.env src/lib/rag/build-kb.js",
    "test:retrieve": "node --env-file=.env src/lib/rag/test-retrieve.js",
    "eval": "node --env-file=.env src/lib/rag/eval.js",
    "eval:triage": "node --env-file=.env src/lib/triage/eval.js",
    "test:safety": "node src/lib/triage/test-safety.js",
    "test:hospitals": "node src/lib/hospital/test-nearby.js",
    "test:plan": "node src/lib/hospital/test-plan.js",
    "test:access": "node server/test-access.js",
    "triage": "node --env-file=.env scripts/triage-cli.js",
    "dev": "concurrently -n api,web -c blue,green \"npm:server\" \"vite\"",
    "server": "node --env-file=.env server/index.js",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^1.1.1",
    "@anthropic-ai/sdk": "^1.3.0",
    "adm-zip": "^0.6.1",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.11.2",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.169.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "vite": "^8.3.5"
  }
}
